{
  "name": "ngsi-ld-sdk",
  "version": "0.0.0",
  "description": "NGSI-LD SDK for interacting with FIWARE Orion-LD broker",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "test -f ngsi-ld-api.yaml || curl -sL https://forge.etsi.org/rep/cim/ngsi-ld-openapi/-/raw/v1.8.1/openapi-3.0.3/ngsi-ld-api.yaml -o ngsi-ld-api.yaml; orval",
    "orion:up": "podman compose -f tests/docker-test-orion/compose.yaml up -d",
    "orion:down": "podman compose -f tests/docker-test-orion/compose.yaml down",
    "orion-temporal:up": "podman compose -f tests/docker-test-orion-with-temporal/compose.yaml up -d",
    "orion-temporal:down": "podman compose -f tests/docker-test-orion-with-temporal/compose.yaml down"
  },
  "license": "MIT",
  "devDependencies": {
    "orval": "^8.19.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
