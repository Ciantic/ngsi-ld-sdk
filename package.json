{
  "name": "ngsi-ld-sdk",
  "version": "0.0.0",
  "description": "NGSI-LD SDK for interacting with FIWARE Orion-LD broker",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "node ./scripts/docs/generate.ts",
    "orion-temporal:up": "podman compose -f tests/docker-test-orion-with-temporal/compose.yaml up -d",
    "orion-temporal:down": "podman compose -f tests/docker-test-orion-with-temporal/compose.yaml down",
    "test:docker-orion": "node test-runner.ts docker-test-orion http://orion-ld:1026/ngsi-ld/v1",
    "test:docker-orion-temporal": "node test-runner.ts docker-test-orion-with-temporal http://orion-ld:1026/ngsi-ld/v1",
    "test:docker-stellio": "node test-runner.ts docker-test-stellio http://api-gateway:8080/ngsi-ld/v1"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.1",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
